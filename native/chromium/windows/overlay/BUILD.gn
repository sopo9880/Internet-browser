source_set("transport") {
  sources = [ "transport.cc", "transport.h" ]
  public_deps = [ "//base" ]
  deps = [ "//chrome/common" ]
  libs = [ "ws2_32.lib" ]
}

source_set("ui") {
  sources = [ "internet_browser_ui.cc", "internet_browser_ui.h", "resources.h" ]
  public_deps = [ "//content/public/browser" ]
  deps = [
    ":transport",
    ":legacy_data",
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/bookmarks",
    "//components/bookmarks/browser",
    "//content/public/common",
    "//ui/base:types",
  ]
}

source_set("legacy_data") {
  sources = [ "legacy_data.cc", "legacy_data.h" ]
  public_deps = [ "//base" ]
  deps = [ "//chrome/common", "//net", "//url" ]
}
